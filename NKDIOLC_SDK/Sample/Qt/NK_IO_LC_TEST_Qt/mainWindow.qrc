        <file alias="btncheckoff4">resources/images/btncheckoff4.png</file>
        <file alias="btncheckon1">resources/images/btncheckon1.png</file>
        <file alias="btncheckon2">resources/images/btncheckon2.png</file>
        <file alias="btncheckon4">resources/images/btncheckon4.png</file>
    </qresource>
</RCC>
